{
  "name": "@rivium-trace/cli",
  "version": "0.1.0",
  "description": "Command-line tool for Rivium Trace — upload sourcemaps, manage releases, and integrate with CI/CD pipelines.",
  "keywords": [
    "rivium",
    "rivium-trace",
    "cli",
    "sourcemaps",
    "error-tracking",
    "apm"
  ],
  "author": "Rivium <hello@rivium.co>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rivium-co/rivium-trace-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Rivium-co/rivium-trace-cli/issues"
  },
  "homepage": "https://rivium.co/trace",
  "bin": {
    "rivium-trace": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format cjs --dts --clean",
    "dev": "tsup src/cli.ts --format cjs --watch",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "form-data": "^4.0.1",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0"
  }
}
